# ─────────────────────────────────────────────────────────────
# yunzone-service-kit 环境变量实例（.env.example）
#
# 用法：
#   1. 拷贝为 .env：  cp .env.example .env（部署时拷贝到服务目录）
#   2. 启动时 loadEnv(schema, { dotenv: true }) 自动灌入
#   3. 值留空或整行注释掉 = 该变量按 unset 处理（全部 optional，缺省降级）
#
# 语法说明（parseDotEnv 子集）：
#   - 仅支持整行注释（# 开头）；不支持行尾内联注释与多行值
#   - 值支持单/双引号；双引号支持 \n \r \t 转义
#   - 默认不覆盖 process.env 已有变量（平台注入优先）
# ─────────────────────────────────────────────────────────────

# ── 部署面（deploymentFacet）：中立键（TICKET-001）──────────────
# 部署平台分派键：self（默认，通用模式，中立键直读）/ coze（Coze 部署必须显式设置，
# 启用 COZE_*、DEPLOY_RUN_PORT 平台注入回退）；vercel/render 等未落地
# 平台注入旧名（COZE_*、DEPLOY_RUN_PORT）由适配层永久回退映射（变量名不可改名，禁止裸读）
DEPLOY_PROVIDER=self

# 部署环境标识：DEV / PROD 等；DEV 时 resolveBaseUrl 回退到本地地址
# （平台旧名：COZE_PROJECT_ENV，经适配层永久回退）
DEPLOY_ENV=DEV

# 项目默认域名（resolveBaseUrl 解析链第三位）
# （平台旧名：COZE_PROJECT_DOMAIN_DEFAULT，经适配层永久回退）
PROJECT_DOMAIN_DEFAULT=

# 服务对外 baseUrl 中立显式项（resolveBaseUrl 解析链最高优先级，规范推荐）
PUBLIC_BASE_URL=

# 历史遗留兼容键（better-auth 库名遗留，omni-auth 外部包契约）；解析链第二位
# 不迁移、不降级，但新代码应使用 PUBLIC_BASE_URL
BETTER_AUTH_URL=

# 监听地址 host（resolveListenAddress，默认 0.0.0.0）
HOSTNAME=0.0.0.0

# 监听端口（resolveListenAddress，默认 5000；平台旧名 DEPLOY_RUN_PORT 经适配层回退）
PORT=5000

# 项目工作区路径（按需使用；平台旧名：COZE_WORKSPACE_PATH，经适配层永久回退）
WORKSPACE_PATH=

# ── 鉴权中心凭证：不走环境变量 ─────────────────────────────
# 服务凭证（apiKey / productId / 服务地址）唯一渠道是凭证文件：
# 签发/轮换凭证时从鉴权中心管理后台下载 auth-center.credential.json，
# 放置到服务目录并加入 .gitignore（见 kit /auth 的 loadAuthCenterCredential）

# ── 管理面（adminFacet）：管理后台公共逻辑 ─────────────────────
# 管理后台密码；【未设置 = 管理后台禁用（503）】，禁止默认密码回退
ADMIN_PASSWORD=

# 管理后台路径前缀（默认 /admin）
ADMIN_PATH=/admin

# 管理后台用户名（可选）：设置后启用「用户名 + 密码」双凭证认证
ADMIN_USERNAME=

# 会话有效期（秒，默认 86400 = 24h）；非法/非正数值回退默认
ADMIN_SESSION_MAX_AGE=

# ── 数据库（resolveDatabaseChannel / resolveDatabaseUrl）──────────
# 数据库渠道：postgres（默认，读 DATABASE_URL）/ coze（平台注入 PG 变量组）
# / none（显式无库声明，createSqlDb 对其 fail-fast，业务改用非库存储）
# 显式声明，不自动嗅探
DATABASE_PROVIDER=postgres

# postgres 模式下的连接 URL
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# 分段输入（可选）：密码原始明文，kit 自动 URL 编码（可含 @ # : / ? % 空格等任意字符）
# 设置后覆盖 URL 内嵌密码；此模式下 URL 内不应再写密码（userinfo 不得含未编码特殊字符）
DATABASE_PASSWORD=

# ── coze 分派私有组（DEPLOY_PROVIDER=coze / DATABASE_PROVIDER=coze 时由平台注入）──
# 键名本身不含平台名，属平台注入私有变量组，不进通用契约（TICKET-001）
# 优先使用完整连接字符串（多余 query 参数会被剥离）
PGDATABASE_URL=

# 组件变量拼接方式（PGDATABASE_URL 未设置时使用）
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres

# ── 对象存储（resolveStorageChannel / resolveStorageConfig）──────
# 存储渠道：s3（默认，读 S3_* 变量组）/ coze（平台注入 COZE_BUCKET_* 变量组）
# / none（显式无存储声明，createObjectStore 对其 fail-fast）
# 显式声明，不自动嗅探
STORAGE_PROVIDER=s3

# s3 渠道必填：S3 兼容端点与桶名
S3_ENDPOINT_URL=
S3_BUCKET_NAME=

# s3 渠道可选凭证：两者必须同设或同不设（只设其一 → fail-fast）；
# 同不设时走 SDK 默认凭证链
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 寻址方式：默认 true（path-style，兼容 MinIO 等非 AWS 端点）；
# 阿里云 OSS 等要求 virtual-hosted 的服务设为 false
S3_FORCE_PATH_STYLE=true

# S3Client 签名 region（默认 us-east-1；OSS 需设为实际地域，如 cn-hangzhou）
S3_REGION=

# ── coze 存储私有组（STORAGE_PROVIDER=coze 时由平台注入）──────────
# 键名含平台名，属平台注入私有命名空间：不进通用契约，项目不写入实际值
# （loadDotEnv 默认平台注入优先），服务侧需经自有 schema 显式声明后由 loadEnv 读取
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=
COZE_BUCKET_ACCESS_KEY_ID=
COZE_BUCKET_SECRET_ACCESS_KEY=
COZE_BUCKET_FORCE_PATH_STYLE=
