{
  "name": "yunzone-service-kit",
  "version": "0.10.0",
  "description": "云洲服务集群通用基础设施：插件式注册中心基座（/registry）、运行时配置层（/config）、SQL 数据库抽象（/db）、共享原语（/core）与运维数据接口（/ops）",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "require": "./dist/registry/index.cjs"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.cjs"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js",
      "require": "./dist/ops/index.cjs"
    },
    "./ops/next": {
      "types": "./dist/ops/next.d.ts",
      "import": "./dist/ops/next.js",
      "require": "./dist/ops/next.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js",
      "require": "./dist/db/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "ts-check": "tsc -p tsconfig.json"
  },
  "keywords": [
    "yunzone",
    "service-kit",
    "registry",
    "config",
    "provider",
    "db",
    "adapter",
    "storage",
    "microservices"
  ],
  "peerDependencies": {
    "next": ">=14",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "next": "16.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^3.0.0",
    "zod": "^4.3.5"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
